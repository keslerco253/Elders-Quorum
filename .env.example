# Settings for the app. On Windows, INSTALL.bat creates them at
# %USERPROFILE%\EldersQuorumApp\settings.env (open with OPEN-SETTINGS.bat).
# Elsewhere, copy this file to ".env". Never share or commit your settings.

# The public address of the app (from Tailscale Funnel or Cloudflare). No trailing slash.
APP_URL=https://your-computer.your-tailnet.ts.net

# Gmail account that sends sign-in links and notifications.
SMTP_USER=villaseldersquorum@gmail.com
# A Gmail "app password" (16 letters), NOT the normal Gmail password.
SMTP_PASS=
MAIL_FROM_NAME=Villas Ward Elders Quorum

# The site owner's email: that account can see every ward, turn texting on for
# wards others start, and back up or restore the app (More → Site owner).
OWNER_EMAIL=

# Optional. Only for restoring a backup onto a brand-new, empty server from its
# setup page. (Or start a ward with OWNER_EMAIL and restore from Site owner.)
SETUP_CODE=

# Port on this computer. Change it if another program already uses 3000.
APP_PORT=3000

# While your texting campaign is waiting for approval, set this to 1 so the
# join page shows the mobile-number consent wording reviewers look for.
# (Phone numbers aren't accepted until the TWILIO_ lines are filled in.)
SMS_PENDING=

# Texting (optional). From your Twilio console. Leave blank for email only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number texts come from, like +12085550100
TWILIO_FROM=

# Only after moving the app to another server: the new address. This copy
# then sends everyone there and stops sending reminders (docs/SETUP-NORTHFLANK.md).
MOVED_TO=

# Only if using Cloudflare Tunnel (optional):
CLOUDFLARE_TUNNEL_TOKEN=
